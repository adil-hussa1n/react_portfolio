                  <span className="text-purple-600 dark:text-purple-400">const</span> <span className="text-blue-600 dark:text-blue-400">mySkills</span> <span className="text-gray-600 dark:text-gray-400">= {'{'}...{'}'}</span> <span className="text-gray-500 dark:text-gray-400">// Explore my technical expertise below</span>
