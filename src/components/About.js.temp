                  <div className="pl-4 mt-2">
                    <span className="text-green-600 dark:text-green-400">role:</span> <span className="text-orange-600 dark:text-orange-400">'IT Instructor & Full Stack Developer'</span><span className="text-gray-600 dark:text-gray-400">,</span>
